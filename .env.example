# Wildcard DNS for *.preview.example.com must point to this server.
LCL_DOMAIN=preview.example.com

# Host directory watched by Traefik's file provider.
TRAEFIK_DYNAMIC_DIR=/path/to/traefik/dynamic

# Existing Docker network shared with Traefik. No TCP port is published.
TRAEFIK_NETWORK=traefik
LCL_LISTEN=0.0.0.0:19473
LCL_BACKEND_URL=http://lcl-broker:19473

LCL_HTTP_ENTRYPOINT=http
LCL_HTTPS_ENTRYPOINT=https

# Existing ACME resolver; empty means use certificates already loaded by Traefik.
LCL_CERT_RESOLVER=

# UID/GID with write access to the dynamic directory and /run/lcl.
LCL_UID=0
LCL_GID=0
